{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "design",
        "page"
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "origin": {
          "default": {},
          "type": "object",
          "properties": {
            "figma": {
              "type": "object",
              "properties": {
                "fileKey": {
                  "type": "string",
                  "minLength": 1
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "fileKey",
                "nodeId"
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "capturedAt"
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path",
            "width",
            "height"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "scale"
      ]
    },
    "palette": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "hex"
            ]
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "weights": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": [
              "family",
              "weights"
            ]
          }
        }
      },
      "required": [
        "colors",
        "fonts"
      ]
    },
    "ignore": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "selector"
            ]
          },
          {
            "type": "object",
            "properties": {
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              }
            },
            "required": [
              "rect"
            ]
          }
        ]
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "box",
              "image"
            ]
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "z": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "box": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "text": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "normalized": {
                "type": "string"
              },
              "clipped": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "overflow",
                      "ellipsis",
                      "line-clamp"
                    ]
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            "required": [
              "content",
              "normalized"
            ]
          },
          "style": {
            "type": "object",
            "properties": {
              "fontFamily": {
                "type": "string",
                "minLength": 1
              },
              "fontSize": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fontWeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "lineHeight": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "letterSpacing": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
              },
              "background": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
              },
              "border": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "solid",
                      "dashed",
                      "dotted",
                      "double"
                    ]
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
                  }
                },
                "required": [
                  "width",
                  "color"
                ]
              },
              "radius": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              },
              "shadows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "blur": {
                      "type": "number",
                      "minimum": 0
                    },
                    "spread": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
                    },
                    "inset": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "blur",
                    "spread",
                    "color"
                  ]
                }
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "image": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "parentId",
          "z",
          "box",
          "style"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "meta",
    "canvas",
    "elements"
  ]
}
