{
  "name": "paridad",
  "version": "0.0.0",
  "private": true,
  "description": "Paridad: compara un frame de Figma con la página construida y reporta lo que no coincide.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "schema:json": "tsx scripts/generate-json-schema.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
